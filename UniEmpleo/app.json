{
  "expo": {
    "name": "UniEmpleo",
    "slug": "UniEmpleo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "uniempleo",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.unipaz.uniempleo",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1B4C"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}