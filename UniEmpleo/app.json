{
  "expo": {
    "name": "UniEmpleo",
    "slug": "UniEmpleo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "uniempleo",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/uniempleo-icon.png",
    "android": {
      "package": "com.unipaz.uniempleo",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/uniempleo-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/uniempleo-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}